# ---------------------------------------------------------------------------
# AWS Serverless AI Document Summarizer — environment configuration
#
# Copy this file to `.env.local` (Vite loads it automatically) and adjust the
# values below. Only variables prefixed with `VITE_` are exposed to the client.
# ---------------------------------------------------------------------------

# Base URL of the deployed API Gateway stage — no trailing slash.
# Example: https://a1b2c3d4e5.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_API_URL=

# Force the in-browser mock backend on/off.
#   true  -> always use the local mock data layer (zero network calls)
#   false -> never mock; the app fails loudly when VITE_AWS_API_URL is missing
#   unset -> mock automatically whenever VITE_AWS_API_URL is empty
VITE_USE_MOCK_API=

# Region label rendered inside the console header badges.
VITE_AWS_REGION=us-east-1